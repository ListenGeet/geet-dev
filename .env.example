# Dummy values only. Copy to web/.env.local and api/.env.local and fill in real values there.
# Never commit real values. Each phase adds the variables it needs (docs/12).

# --- web and api ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# When 1, the build fails on a missing required variable (CI sets it).
REQUIRE_ENV=

# --- web only ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- api only ---
# Comma separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# --- Phase 1: sign-in, database, email (dummy values; real ones in .env.local or Vercel) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_dummy
# api only
CLERK_SECRET_KEY=sk_test_dummy_value
CLERK_WEBHOOK_SECRET=whsec_dummy_dummy_dummy
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=dummy-service-role
RESEND_API_KEY=re_dummy_key
EMAIL_FROM_SECURITY=Geet Security <security@example.com>
EMAIL_FROM_HELLO=Geet <hello@example.com>
EMAIL_REPLY_TO_SUPPORT=support@example.com
ADMIN_EMAILS=you@example.com
# Dev only: comma separated. When set (or on a dev host), only these addresses get email, with a [DEV] prefix.
EMAIL_DEV_ALLOWLIST=

# --- Phase 2: storage and transcode worker (dummy values; set privately per environment) ---
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=audio
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_ENDPOINT=
WORKER_SECRET=worker-secret-dummy-change-me
UPLOAD_MODE=admin
MAX_TRACK_MB=50
MAX_UPLOADS_PER_DAY=5
GH_DISPATCH_TOKEN=ghp_dummy_token
GH_REPO=owner/geet
