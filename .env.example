# Dummy values only. Copy to web/.env.local and api/.env.local and fill in real values there.
# Never commit real values. Each phase adds the variables it needs (docs/12).

# --- web and api ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# When 1, the build fails on a missing required variable (CI sets it).
REQUIRE_ENV=

# --- web only ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- api only ---
# Comma separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000
